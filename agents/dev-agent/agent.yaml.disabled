# Agent configuration
#
# Then add your bot token to .env:
#   DEV_AGENT_BOT_TOKEN=1234567890:AAFxxxxxxx
#
# Start with:
#   npm start -- --agent dev-agent

name: Dev Agent
description: Autonomous developer that executes implementation plans from architect in isolated worktrees

telegram_bot_token_env: DEV_AGENT_BOT_TOKEN
model: claude-sonnet-4-6
